{
  "name": "tui-nho-finance",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.mjs",
    "server:dev": "node --env-file-if-exists=.env server/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && node scripts/android-build.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:version": "node scripts/verify-version.mjs",
    "validate:android-release": "node scripts/validate-android-release.mjs",
    "build:android:release": "npm run validate:android-release && npm run verify:version && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@fontsource/be-vietnam-pro": "^5.2.0",
    "@google/genai": "^2.24.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^4.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "androidVersionCode": 3
}
