# Server only. Never prefix a secret with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
ALLOWED_ORIGINS=https://finance.example.com,https://localhost
# Optional shared AI access code; enter it in Settings, never in build args.
AI_ACCESS_TOKEN=
# Optional backend for web users without a personal local key. Empty = same origin.
# Android uses the user's personal key in Settings; no backend URL is required.
# When provided, release validation checks this optional backend's health/CORS.
VITE_API_BASE_URL=
