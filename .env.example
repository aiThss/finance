# Server only. Never prefix a secret with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3000
ALLOWED_ORIGINS=https://finance.example.com
# Optional shared AI access code; enter it in Settings, never in build args.
AI_ACCESS_TOKEN=
# Default empty = same origin. For Android set the deployed HTTPS origin at build time.
VITE_API_BASE_URL=
